DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public"
SHADOW_DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_SHADOW?schema=public"
JWT_SECRET="replace-with-secure-secret"
PORT=3000
TELEGRAM_BOT_TOKEN="replace-with-bot-token-from-botfather"
# webhook | polling (default: polling for local dev)
TELEGRAM_MODE="polling"
# Required if TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_DOMAIN="https://your-domain.com"
# Optional but recommended: secret token for webhook verification
TELEGRAM_SECRET_TOKEN="replace-with-random-secret"
GEMINI_API_KEY="replace-with-gemini-api-key"
